{
  "prefetch": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/search/*" } },
          { "not": { "href_matches": "/*.epub" } },
          { "not": { "href_matches": "/*.md" } },
          { "not": { "href_matches": "/*.tei.xml" } },
          { "not": { "selector_matches": "[download]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
