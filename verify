#!/usr/bin/env bash
# One command that says whether the site is fit to publish. CI runs it on every push.
#   ./verify                 site checks, plus the pipeline's own ./verify if ../Paper Lanterns New is present
#   ./verify --skip-pipeline site checks only
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
PIPELINE="${PL_PIPELINE:-$ROOT/../Paper Lanterns New}"
HUGO="${HUGO:-hugo}"
SKIP_PIPELINE=0
[[ "${1:-}" == "--skip-pipeline" ]] && SKIP_PIPELINE=1

step() { printf '\n==> %s\n' "$1"; }

step "[1/9] Hugo version is the pinned one ($(cat .hugo-version))"
want="$(cat .hugo-version)"
have="$("$HUGO" version | sed -E 's/^hugo v([0-9.]+).*/\1/')"
if [[ "$have" != "$want" ]]; then
  echo "Hugo $have found, but .hugo-version pins $want (set HUGO=/path/to/hugo)" >&2
  exit 1
fi
echo "hugo $have"

step "[2/9] No secrets anywhere in git history (gitleaks $(cat .gitleaks-version))"
gl_want="$(cat .gitleaks-version)"
gl_have="$(gitleaks version | tr -d 'v')"
if [[ "$gl_have" != "$gl_want" ]]; then
  echo "gitleaks $gl_have found, but .gitleaks-version pins $gl_want" >&2
  exit 1
fi
gitleaks git --redact --no-banner --exit-code 1 .

step "[3/9] JavaScript parses"
node --check assets/js/site.js
node --check assets/js/theme.js
echo "assets/js/site.js and assets/js/theme.js OK"

step "[4/9] Script tests (sync, site checker, share-card images)"
python3 -I -m unittest discover -s tests
node --test tests/*.test.mjs

step "[5/9] Synced content matches the pipeline output and the old site's files"
if [[ -d "$PIPELINE/library" ]]; then
  for book in content/collections/*/; do
    python3 -I scripts/sync_from_pipeline.py --check --pipeline "$PIPELINE" "$(basename "$book")"
  done
else
  echo "skipped: pipeline repository not found at $PIPELINE (expected in CI)"
fi
LEGACY_SITE="${PL_LEGACY_SITE:-$HOME/Documents/Bhuvan/A main projects/Paper-lanterns}"
python3 -I scripts/build_indexes.py --check
echo "data/decades.json and data/people.json are current"
if [[ -d "$LEGACY_SITE/src/content" ]]; then
  python3 -I scripts/import_legacy.py --check "$LEGACY_SITE"
else
  echo "skipped: old Astro site not found at $LEGACY_SITE (expected in CI)"
fi

step "[6/9] Hugo build (warnings are errors), share cards and the Pagefind search index"
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT
python3 -I scripts/fetch_plates.py --check
"$HUGO" --gc --minify --panicOnWarning --printPathWarnings --quiet --destination "$OUT"
node scripts/og_cards.mjs "$OUT"
echo "built $(find "$OUT" -name '*.html' | wc -l) pages"
pf_want="$(cat .pagefind-version)"
pf_have="$(pagefind --version | awk '{print $2}')"
if [[ "$pf_have" != "$pf_want" ]]; then
  echo "pagefind $pf_have found, but .pagefind-version pins $pf_want" >&2
  exit 1
fi
pagefind --site "$OUT" --quiet
files=$(find "$OUT" -type f | wc -l)
echo "search index built; $files files in all (Cloudflare Pages allows 20000)"
if (( files > 19000 )); then
  echo "Too close to Cloudflare Pages' 20000-file limit" >&2
  exit 1
fi

step "[7/9] Built pages: structure, links, CSP rules, published addresses, JavaScript budget"
python3 -I scripts/check_site.py "$OUT"
python3 -I scripts/addresses.py check "$OUT"
js_bytes=$(find "$OUT/js" -name '*.js' -exec cat {} + | wc -c)
if (( js_bytes > 50000 )); then
  echo "JavaScript is $js_bytes bytes; the budget is 50000" >&2
  exit 1
fi
echo "JavaScript: $js_bytes bytes (budget 50000)"

step "[8/9] Phones and tablets: headless Chromium at 360, 390 and 768 px"
node scripts/check_mobile.mjs "$OUT"

step "[9/9] Pipeline's own verify"
if [[ $SKIP_PIPELINE -eq 1 ]]; then
  echo "skipped (--skip-pipeline)"
elif [[ -x "$PIPELINE/verify" ]]; then
  (cd "$PIPELINE" && ./verify)
else
  echo "skipped: pipeline repository not found at $PIPELINE (expected in CI)"
fi

printf '\n==> ALL CHECKS PASSED\n'
